# Copy this file to .env and add real values there. Never commit .env.
NODE_ENV=development
PORT=5000
GOOGLE_PLACES_API_KEY=replace_with_your_google_places_api_key

# Safety limits enforced by the application. Keep these below Google's current
# free allowance; change them only after reviewing the active Google pricing.
GOOGLE_PLACES_MONTHLY_REQUEST_LIMIT=900
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=5
GOOGLE_PLACES_REQUESTS_PER_MINUTE=5
MAX_SEARCH_RESULTS=50

# Server-only Supabase connection. Get these from Project Settings > API.
# Use the Secret key, never the browser Publishable key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_secret_key
